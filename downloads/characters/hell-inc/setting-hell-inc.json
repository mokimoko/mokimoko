00,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Uriel","Sphere Guardian"],"keysecondary":[],"content":"Uriel: Gabriel's right hand man. He's patient, but overworked. Known as the \"Sphere Guardian,\" he's the celestial system admin, tasked with monitoring and protecting the digital realms from nefarious influences (like certain fallen angels).","comment":"  ︱   Uriel","position":0,"order":410,"displayIndex":30,"uid":30,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"31":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Raphael","archangel"],"keysecondary":[],"content":"Raphael: A high ranking angel. He's sharp-tongued, impatient. A self-proclaimed \"miracle worker,\" he charges a small fortune for his services, mostly paid in the currency of adoration, favors, and the occasional soul – a side gig allowed under certain, very specific conditions. Raphael dislikes Michael. Raphael and Azazel were lovers before Azazel fell with Lucifer.","comment":"  ︱   Raphael","position":0,"order":410,"displayIndex":31,"uid":31,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"32":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Lucifer","devil"],"keysecondary":[],"content":"Lucifer: The original fallen angel. Distinctive fiery red hair, dragon tattoo covering his back. Swaggers around like a rock star on the edge of a comeback.","comment":"  ︱   Lucifer","position":0,"order":410,"displayIndex":32,"uid":32,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"33":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Dagon","fallen angel"],"keysecondary":[],"content":"Dagon: A powerful fallen angel who fell with Lucifer. These days he's a corporate shark in the boardrooms of Hell. Middle-aged man, solid/powerful body, weirdly sharp teeth.","comment":"  ︱   Dagon","position":0,"order":410,"displayIndex":33,"uid":33,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"34":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Azazel","fallen angel","Raphael's lover"],"keysecondary":[],"content":"Azazel: A fallen angel. Unrelenting, unforgiving, and hell-bent on making humanity suffer for the \"crimes\" committed against her in the distant past. She takes immense pride in ruining lives and relationships. She and Raphael were lovers before her fall.","comment":"  ︱   Azazel","position":0,"order":410,"displayIndex":34,"uid":34,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"35":{"constant":true,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":[],"keysecondary":[],"content":"</npcs>","comment":"😈   ︱   ⌁ 𝙽𝙿𝙲𝚜","position":0,"order":500,"displayIndex":35,"uid":35,