{"name":"Setting - Hell Inc","entries":{"0":{"constant":true,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":[],"keysecondary":[],"content":"<locations>","comment":"😈   ︱   𝙻𝚘𝚌𝚊𝚝𝚒𝚘𝚗𝚜","position":0,"order":100,"displayIndex":0,"uid":0,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"1":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["setting","modern urban fantasy","heaven","hell","angels","demons","contracts"],"keysecondary":[],"content":"<setting>\nA modern urban fantasy world; demons, fallen angels, and angels secretly influence human lives. Heaven and Hell function as competing bureaucracies.\nHell: Bureaucratic nightmare with cities like Pandemonium (main hub) and Limbo City (black market haven). \nDemons: Corrupted mortal souls or Hell-born entities like hellhounds. All serve fallen angel masters through blood contracts and absolute loyalty. \nAngels: Guardian angels (former humans) patrol Earth to protect mortals from demonic influence. They're bound by strict Guidelines and report to higher authorities.\nContracts: Binding magical agreements that demons and fallen angels use to claim souls. Must be fulfilled exactly as written, leading to creative interpretations and loopholes.\nGuidelines: Rules all guardian angels MUST follow. Examples: respect free will, no romantic relationships, hide true nature, report to superiors, etc.\n</setting>","comment":"  ︱   Setting","position":0,"order":110,"displayIndex":1,"uid":1,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"2":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Heaven","paradise","heavenly","celestial"],"keysecondary":[],"content":"Heaven: a massive celestial bureaucracy run like a modern corporation. Organized in strict hierarchies with archangels as executives, guardian angels as middle management, and various departments handling different aspects of divine intervention. Known for inefficiency, paperwork, and corporate politics rivaling any earthly company.","comment":"  ︱   Heaven","position":0,"order":120,"displayIndex":2,"uid":2,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"3":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Limbo City","Limbo","border town"],"keysecondary":[],"content":"Limbo City: Located on the outskirts of Hell just beyond the River Styx. A lawless frontier town with a thriving black market and criminal underworld. Smugglers bring Earth goods through here, and it serves as a meeting point between Hell's official business and its shadier enterprises.","comment":"  ︱   Limbo City","position":0,"order":120,"displayIndex":3,"uid":3,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"4":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["River Styx","Styx","river","border"],"keysecondary":[],"content":"the River Styx: The legendary river that separates Hell from other realms, flowing adjacent to Limbo City. Its waters have the supernatural property of erasing memories from anyone who drinks from them. Serves as both a natural border and a tool for those seeking to forget their past sins or traumas.","comment":"  ︱   River Styx","position":0,"order":120,"displayIndex":4,"uid":4,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"5":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Pandemonium","capital","Hell capital"],"keysecondary":[],"content":"Pandemonium: The largest and most important city in Hell, serving as the realm's bustling capital. Chaotic and crawling with demons, it features towering high-rise buildings that reflect the scarlet sky. Houses Hell's major corporate headquarters and government facilities. The center of infernal politics and business.","comment":"  ︱   Pandemonium","position":0,"order":120,"displayIndex":5,"uid":5,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"6":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Hell","infernal","hellish","underworld"],"keysecondary":[],"content":"Hell: functions as a corporate rival to Heaven, complete with subsidiaries, boardrooms, and business ventures on Earth. Ruled by fallen angels who act as executives, with demons serving as employees. Located beyond the River Styx, Hell is a sprawling realm of cities, estates, and corporate headquarters where deals are made and souls are traded.","comment":"  ︱   Hell","position":0,"order":120,"displayIndex":6,"uid":6,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"7":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Earth","mortal world","human world","material plane"],"keysecondary":[],"content":"Earth: serves as the battleground between Heaven and Hell's influence. Humans remain largely unaware of the supernatural war being waged over their souls. Both sides maintain corporate presences, with fallen angels running legitimate businesses and angels working through various charitable organizations.","comment":"  ︱   Earth","position":0,"order":120,"displayIndex":7,"uid":7,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"8":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Celestial Spire","Spire","Heaven's headquarters","divine tower"],"keysecondary":[],"content":"Celestial Spire: aka the Spire. Heaven's primary administrative building, a magnificent crystalline tower that stretches infinitely upward through clouds of golden light. Houses the offices of all archangels, with Michael's executive suite at the pinnacle. Features endless floors of cubicles, conference rooms, and filing departments where angelic bureaucrats process prayers, miracle requests, and soul evaluations.","comment":"  ︱   Celestial Spire","position":0,"order":120,"displayIndex":8,"uid":8,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"9":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Divine Assembly","heavenly parliament","celestial congress"],"keysecondary":[],"content":"Divine Assembly: Heaven's primary legislative and judicial chamber where major decisions are made through committee votes and endless debates. Features amphitheater seating with clouds of light serving as desks. Known for marathon sessions, bureaucratic gridlock, and Gabriel's attempts to maintain order through detailed agendas and the Rules of Order.","comment":"  ︱   Divine Assembly","position":0,"order":120,"displayIndex":9,"uid":9,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"10":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Miracle Department","divine intervention bureau","heavenly services"],"keysecondary":[],"content":"the Miracle Department: A massive office complex where miracle requests are processed, evaluated, and approved through layers of bureaucracy. Features intake desks, assessment committees, and approval chains. Raphael maintains a private office here where he conducts his fee-for-service miracle work, much to the administration's quiet disapproval.","comment":"  ︱   Miracle Department","position":0,"order":120,"displayIndex":10,"uid":10,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"11":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Guardian Academy","angel bootcamp","guardian angel orientation","angel training","academy"],"keysecondary":[],"content":"Guardian Academy: aka \"angel bootcamp\". Expansive facilities where new guardian angels learn their duties and existing angels maintain their skills. Features obstacle courses through cloud formations, meditation gardens, and lecture halls. Houses both the Guardian Angel Orientation Program and advanced combat training for those dealing with demonic incursions.","comment":"  ︱   Guardian Academy","position":0,"order":120,"displayIndex":11,"uid":11,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"12":{"constant":true,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":[],"keysecondary":[],"content":"</locations>\n<world_lore>","comment":"😈   ︱   𝚆𝚘𝚛𝚕𝚍 𝙻𝚘𝚛𝚎","position":0,"order":200,"displayIndex":12,"uid":12,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"13":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["angels","angel","celestial beings","heavenly host"],"keysecondary":[],"content":"Angels: Two types exist: Upper-level angels like Michael, Gabriel, Uriel, and Raphael were formed directly from divine light and rarely interact with mortals. Guardian angels are former humans recruited after death to watch over living humans. All angels must follow strict Guidelines governing their behavior and interactions with mortals.","comment":"  ︱   Angels","position":0,"order":210,"displayIndex":13,"uid":13,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"14":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["demons","demon","evil"],"keysecondary":[],"content":"Demons: Two origins: corrupted mortal souls damned to Hell, or malevolent entities spawned directly in Hell's depths. All demons serve fallen angel masters and can travel to Earth to recruit souls. They despise angels and attack them as part of the eternal war. Most take corporate positions in Hell's business structure.","comment":"  ︱   Demons","position":0,"order":210,"displayIndex":14,"uid":14,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"15":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["fallen angels","fallen angel","corrupted angels"],"keysecondary":["fallen"],"content":"Fallen angels: Former angels who rebelled against Heaven's hierarchy and were cast out. Retain angelic powers but have corrupted them to use them for evil. They command demons, try to corrupt human souls, and work to undermine Heaven's influence on Earth.","comment":"  ︱   Fallen Angels","position":0,"order":210,"displayIndex":15,"uid":15,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"16":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Nephilim","starspark","starsparks","half-angel"],"keysecondary":[],"content":"Nephilim: Extremely rare offspring of angels and humans, colloquially called \"starsparks.\" Their existence is forbidden, and discovery could result in severe consequences from both Heaven and Hell. They possess latent supernatural abilities that typically manifest during times of extreme stress or danger.","comment":"  ︱   Nephilim","position":0,"order":210,"displayIndex":16,"uid":16,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"17":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Guardian Angels","guardian angel"],"keysecondary":[],"content":"Guardian angels: Former humans who died and were recruited by Heaven to watch over living mortals. They report to Uriel and must follow the Guidelines strictly. Given specific charges to protect and guide, they work to counter demonic influence while respecting human free will.","comment":"  ︱   Guardian Angels","position":0,"order":210,"displayIndex":17,"uid":17,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"18":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Imp","Imps","minion","minions","hellspawn"],"keysecondary":[],"content":"Imps: a kind of hellspawn. Little demons, weirdly cute in an ugly way. Vassago keeps a bunch of them as minions.","comment":"  ︱   Imps","position":0,"order":240,"displayIndex":18,"uid":18,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"19":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Hellhound","hellhounds","demon dogs"],"keysecondary":[],"content":"Hellhounds: Demonic canines that serve fallen angels and high-ranking demons. Capable of shapeshifting between terrifying supernatural dog forms and humanoid appearances. Born in Hell's depths, they possess enhanced strength, speed, senses, and minor magical abilities. Known for absolute loyalty to their masters.","comment":"  ︱   Hellhounds","position":0,"order":240,"displayIndex":19,"uid":19,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"20":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["contract","contracts","deal","deals","bargain","bargains"],"keysecondary":[],"content":"Contracts: Binding supernatural agreements signed in blood between demons/fallen angels and mortals. The exact terms MUST be fulfilled by both parties, but demons will twist interpretation to their advantage. These contracts can trade incredible power, wealth, or favors in exchange for souls or other prices.","comment":"  ︱   Contracts","position":0,"order":250,"displayIndex":20,"uid":20,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"21":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Guidelines","rules","angel rules","angel laws"],"keysecondary":[],"content":"The Guidelines: Strict rules all guardian angels must follow: Do not interfere with human free will, only guide gently. Do not reveal true angelic nature except to your charge. No romantic relationships with assignments. Do not share heavenly secrets. Only use miracles to save lives. Follow archangel orders. Report regularly on your charge's progress.","comment":"  ︱   The Guidelines","position":0,"order":250,"displayIndex":21,"uid":21,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"22":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["romance","love","sex","romantic","sexual","forbidden love"],"keysecondary":[],"content":"Romance: Angels are strictly forbidden from having romantic or sexual relationships with humans. Discovery results in severe punishment from their superiors, potentially including expulsion from Heaven. This rule exists to prevent complications in their divine duties and maintain the separation between celestial and mortal realms.","comment":"  ︱   Romance","position":0,"order":250,"displayIndex":22,"uid":22,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"23":{"constant":true,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":[],"keysecondary":[],"content":"</world_lore>\n<npcs>","comment":"😈   ︱   𝙽𝙿𝙲𝚜","position":0,"order":400,"displayIndex":23,"uid":23,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"24":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Vassago","Vass","boss","fallen angel"],"keysecondary":[],"content":"Vassago: A refined fallen angel who serves as one of Lucifer's advisors. Tall and elegant with jet-black hair, silver eyes, and aristocratic features. On Earth, he moonlights as CEO of one of Hell's subsidiary companies. Commands a horde of imp minions and the loyal hellhound Jinx. Former rival and commander of Kazimir before his defection.","comment":"  ︱   Vassago","position":0,"order":410,"displayIndex":24,"uid":24,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"25":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Pyralis","Pyr","guardian angel"],"keysecondary":[],"content":"Pyralis: A petite guardian angel with fiery red hair, blue eyes, and freckles. Idealistic and passionate, she represents the newer generation of guardian angels. Often clashes with the more cynical Kazimir and serves as a target for demonic harassment due to her earnest nature.","comment":"  ︱   Pyralis","position":0,"order":410,"displayIndex":25,"uid":25,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"26":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Kazimir","Kaz","Dmitri","guardian angel"],"keysecondary":[],"content":"Kazimir: A guardian angel who was formerly a demon soldier under Vassago's command. Originally human (Dmitri, a Russian revolutionary who died in the late 1800s), he served nearly a century in Hell before defecting to Heaven. Gruff and cynical with platinum blond hair and blue eyes. Now works to prove his redemption while protecting his assigned charge.","comment":"  ︱   Kazimir","position":0,"order":410,"displayIndex":26,"uid":26,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"27":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delayUntilRecursion":false,"matchPersonaDescription":false,"matchCharacterDescription":false,"matchCharacterPersonality":false,"matchCharacterDepthPrompt":false,"matchScenario":false,"matchCreatorNotes":false,"ignoreBudget":false,"triggers":[],"outletName":"","key":["Jinx","hellhound"],"keysecondary":[],"content":"Jinx: A young demon hellhound born in Hell, around 50 years old. Can shapeshift between a terrifying massive black dog and a boyish human form with messy dark hair and red eyes. Abandoned by his parents and raised by Vassago, whom he serves with absolute loyalty. Mischievous, impulsive, and puppylike with his master but playfully vicious with others.","comment":"  ︱   Jinx","position":0,"order":410,"displayIndex":27,"uid":27,"characterFilter":{"isExclude":false,"names":[],"tags":[]}},"28":{"constant":false,"selective":true,"selectiveLogic":0,"addMemo":true,"disable":false,"excludeRecursion":true,"preventRecursion":true,"probability":100,"useProbability":true,"depth":4,"caseSensitive":false,"matchWholeWords":false,"vectorized":false,"role":null,"sticky":0,"cooldown":0,"delay":0,"group":"","groupOverride":false,"groupWeight":100,"scanDepth":null,"useGroupScoring":null,"automationId":"","delay